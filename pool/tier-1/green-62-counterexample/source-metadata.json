  "type_pretty": "True ↔\n  ∀ᶠ (p : ℕ) in Filter.atTop,\n    Nat.Prime p →\n      have A := Finset.filter Nat.Prime (Finset.range p);\n      ∀ (x : ℕ), 1 ≤ x ∧ x < p → ∃ a₁ ∈ A, ∃ a₂ ∈ A, ↑x = ↑a₁ * ↑a₂"
