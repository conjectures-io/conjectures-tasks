  "type_pretty": "∀ (n : ℕ),\n  3 ≤ n →\n    ∀ (p : Fin n → EuclideanSpace ℝ (Fin 2)),\n      Function.Injective p →\n        EuclideanGeometry.IsConvexPolygon p → ∃ i, {d | ∃ j, j ≠ i ∧ d = dist (p i) (p j)}.ncard ≥ n / 2"
