+/-- With no allowed distances, the distance graph has no edges. -/
+theorem distancePlaneGraph_empty (V : Set (EuclideanSpace ℝ (Fin 2))) :
+    DistancePlaneGraph ∅ V = ⊥ := by
+  ext x y
+  simp [distancePlaneGraph_adj]
