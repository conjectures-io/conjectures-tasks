+@[category research open, question value, AMS 5]
+theorem erdos_614 :
+    ∀ n k, IsLeast {m : ℕ | ∃ G : SimpleGraph (Fin n), G.edgeFinset.card = m ∧
+      ∀ s : Finset (Fin n), s.card = k + 2 →
